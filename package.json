{
  "name": "dsh-plugin-writer",
  "version": "0.1.0",
  "description": "DSH 多模型合稿：用宿主已接入的模型并行写同一题目，再由裁判取精去糟并写出终稿。",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.0"
  },
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "cordis.patch.yml",
    "README.md",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-primitives"
      ],
      "platform": "web",
      "immediately": true
    },
    "manifestVersion": 1
  },
  "scripts": {
    "test": "node --test test/council.test.js"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.2.1-rc.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-client-ui-primitives": {
      "optional": true
    }
  }
}
